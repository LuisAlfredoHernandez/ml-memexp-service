import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
import joblib
import os

print("1. Generando datos históricos sintéticos para la fábrica...")
np.random.seed(42)
n_samples = 1000

# Simulamos 1000 pedidos pasados
data = {
    "cantidad_piezas": np.random.randint(50, 5000, n_samples),
    "prioridad_alta": np.random.randint(0, 2, n_samples),
    "lineas_produccion": np.random.randint(1, 6, n_samples),
}
df = pd.DataFrame(data)

# Creamos una variable objetivo (Y) realista:
# A más piezas, más horas. A más líneas, menos horas.
df["tiempo_horas"] = (df["cantidad_piezas"] * 0.45) / df["lineas_produccion"]
# Pedidos urgentes se hacen un 15% más rápido por presión operativa
df.loc[df["prioridad_alta"] == 1, "tiempo_horas"] *= 0.85
# Añadimos un poco de ruido para simular retrasos reales
df["tiempo_horas"] += np.random.normal(0, 5, n_samples)
df["tiempo_horas"] = df["tiempo_horas"].clip(lower=1) # Evitamos tiempos negativos

# Separamos Features (X) y Target (y)
X = df.drop("tiempo_horas", axis=1)
y = df["tiempo_horas"]

print("2. Entrenando RandomForestRegressor...")
modelo_rf = RandomForestRegressor(n_estimators=100, max_depth=10, random_state=42)
modelo_rf.fit(X, y)

print("3. Guardando el modelo entrenado...")
# Verificamos que la carpeta model_artifacts exista un nivel arriba
artifacts_dir = os.path.join(os.path.dirname(__file__), '..', 'model_artifacts')
os.makedirs(artifacts_dir, exist_ok=True)

ruta_modelo = os.path.join(artifacts_dir, 'random_forest_v1.pkl')
joblib.dump(modelo_rf, ruta_modelo)

print(f"✅ ¡Éxito! Modelo exportado a {ruta_modelo}")